// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  phone         String?
  emailVerified Boolean  @default(false)
  isDemo        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions        Session[]
  passkeys        PasskeyCredential[]
  otpCodes        OTPCode[]
  trustedDevices  TrustedDevice[]
  loginHistory    LoginHistory[]
  qrRequests      QRLoginRequest[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  isDemo    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasskeyCredential {
  id              String   @id @default(cuid())
  userId          String
  credentialId    String   @unique
  publicKey       String
  counter         Int      @default(0)
  deviceType      String?
  backedUp        Boolean  @default(false)
  transports      String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OTPCode {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  codeHash  String
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
}

/// One-time QR Login Request for cross-device authentication
model QRLoginRequest {
  id           String   @id @default(cuid())
  requestId    String   @unique
  status       String   @default("pending") // pending, approved, rejected, expired
  deviceInfo   String?  // e.g., Windows Laptop - Chrome
  ipAddress    String?  // e.g., 10.17.87.25
  userId       String?
  sessionToken String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([expiresAt])
}

/// Trusted mobile/browser devices saved for user
model TrustedDevice {
  id                String   @id @default(cuid())
  userId            String
  deviceName        String   // e.g. iPhone 15, Windows PC
  browser           String?  // e.g. Safari 17.0, Chrome 124
  deviceFingerprint String
  lastActive        DateTime @default(now())
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Audit trail of user login events
model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  method    String   // e.g. QR Login, Passkey, Email OTP
  device    String   // e.g. Windows Laptop, iPhone 15
  browser   String?  // e.g. Chrome, Safari
  status    String   // success, rejected, failed
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Pending sign-up verification: stores the sign-up intent (name/email/phone)
/// together with a hashed OTP until the user verifies the code. The account is
/// only created after a successful verification.
model SignupVerification {
  id        String   @id @default(cuid())
  email     String
  fullName  String
  phone     String
  otpHash   String
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

/// Pending passkey sign-up: stores the sign-up intent (name/email/phone) and a
/// prospective userId together with the WebAuthn challenge until the user
/// completes the passkey ceremony. The account is only created after a
/// successful verification — abandoned ceremonies never create a user.
model PasskeySignup {
  id              String   @id @default(cuid())
  email           String
  fullName        String
  phone           String
  prospectiveUserId String
  challenge       String
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([email])
  @@index([prospectiveUserId])
  @@index([expiresAt])
}
