// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  phone         String?
  emailVerified Boolean  @default(false)
  isDemo        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions        Session[]
  passkeys        PasskeyCredential[]
  otpCodes        OTPCode[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  isDemo    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasskeyCredential {
  id              String   @id @default(cuid())
  userId          String
  credentialId    String   @unique
  publicKey       String
  counter         Int      @default(0)
  deviceType      String?
  backedUp        Boolean  @default(false)
  transports      String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OTPCode {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  codeHash  String
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
}

/// Pending sign-up verification: stores the sign-up intent (name/email/phone)
/// together with a hashed OTP until the user verifies the code. The account is
/// only created after a successful verification.
model SignupVerification {
  id        String   @id @default(cuid())
  email     String
  fullName  String
  phone     String
  otpHash   String
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

/// Pending passkey sign-up: stores the sign-up intent (name/email/phone) and a
/// prospective userId together with the WebAuthn challenge until the user
/// completes the passkey ceremony. The account is only created after a
/// successful verification — abandoned ceremonies never create a user.
model PasskeySignup {
  id              String   @id @default(cuid())
  email           String
  fullName        String
  phone           String
  prospectiveUserId String
  challenge       String
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([email])
  @@index([prospectiveUserId])
  @@index([expiresAt])
}
