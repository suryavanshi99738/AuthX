# ============================================================
# BankShield Auth — Development Environment Variables
# ============================================================

# ── Application ──
NEXT_PUBLIC_APP_NAME=BankShield Auth
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENV=development

# ── API Configuration ──
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
NEXT_PUBLIC_API_TIMEOUT=10000

# ── Auth Service Port (for mini-service gateway) ──
AUTH_SERVICE_PORT=3001

# ── Database (Prisma SQLite for Next.js frontend) ──
DATABASE_URL=file:./db/custom.db

# ── Authentication ──
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=bankshield-dev-secret-change-in-production

# ── JWT Configuration ──
JWT_SECRET=bankshield-jwt-dev-secret-change-in-production
JWT_EXPIRES_IN=24h
