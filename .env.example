# ---- BankShield Auth — Environment Variables (example) ----
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env` or `.env.local` — they are gitignored.

# SQLite database connection string
DATABASE_URL=file:./db/custom.db

# --- Email service (Resend) ---
# Server-side only. NEVER prefix with NEXT_PUBLIC_.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Sender address. Must use a domain verified in your Resend account.
# The Resend test sender works for development:
EMAIL_FROM=BankShield Auth <onboarding@resend.dev>

# Public base URL of the app (safe to expose to the browser)
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
